{
  "version": "indicator_scoring_v0.3",
  "status": "provisional",
  "value_function": "clipped_piecewise_linear",
  "reference_workbook": "data/processed/virginia_georgia_normalized_margin_v0.3.xlsx",
  "notes": "Fixed anchors and equal within-dimension indicator weights from Adelyn_final_framework.md. Utilities are 0-100; dimension scores are 0-1. Camille's dimension weights are intentionally not used here.",
  "indicators": {
    "wildfire_bp_national_percentile": {"label": "Wildfire burn-probability national percentile", "dimension": "climate_risk", "unit": "fraction", "direction": "low_better", "transform": null, "ideal_T": 0.2, "unacceptable_L": 0.9, "anchor_basis": "Extreme national tail is the zero-utility boundary while lower-risk counties remain differentiated"},
    "inland_flood_loss_rate_percentile": {"label": "Inland flood expected-loss-rate national percentile", "dimension": "climate_risk", "unit": "fraction", "direction": "low_better", "transform": null, "ideal_T": 0.1, "unacceptable_L": 0.8, "anchor_basis": "Rounded two-state distribution anchors"},
    "baseline_water_stress": {"label": "Baseline water stress (Aqueduct 4.0)", "dimension": "water", "unit": "Aqueduct index 0-5", "direction": "low_better", "transform": null, "ideal_T": 1.0, "unacceptable_L": 4.0, "anchor_basis": "Aqueduct low versus extremely high stress interpretation"},
    "water_stress_2050_bau": {"label": "2050 business-as-usual water stress (Aqueduct 4.0)", "dimension": "water", "unit": "Aqueduct index 0-5", "direction": "low_better", "transform": null, "ideal_T": 1.0, "unacceptable_L": 4.0, "anchor_basis": "Same fixed scale as baseline water stress"},
    "low_impervious_land_share": {"label": "Share of land with < 10% impervious cover", "dimension": "land_ecology", "unit": "fraction", "direction": "high_better", "transform": null, "ideal_T": 0.98, "unacceptable_L": 0.25, "anchor_basis": "County-level developable-land proxy; parcel review remains necessary"},
    "gap12_protected_land_share": {"label": "GAP 1/2 protected land share", "dimension": "land_ecology", "unit": "fraction", "direction": "low_better", "transform": null, "ideal_T": 0.0, "unacceptable_L": 0.25, "anchor_basis": "Rewards low protected-area burden without treating county averages as parcel exclusions"},
    "wetland_land_share": {"label": "Wetland share of land", "dimension": "land_ecology", "unit": "fraction", "direction": "low_better", "transform": null, "ideal_T": 0.0, "unacceptable_L": 0.4, "anchor_basis": "County-level screening anchor; does not replace wetland delineation"},
    "fiber_business_100_20_availability": {"label": "Business fiber availability at 100/20 Mbps", "dimension": "fiber", "unit": "fraction", "direction": "high_better", "transform": null, "ideal_T": 0.9, "unacceptable_L": 0.2, "anchor_basis": "Broad business-service availability proxy"},
    "fiber_business_1000_100_availability": {"label": "Business fiber availability at 1000/100 Mbps", "dimension": "fiber", "unit": "fraction", "direction": "high_better", "transform": null, "ideal_T": 0.9, "unacceptable_L": 0.1, "anchor_basis": "Stricter high-capacity connectivity proxy"},
    "labor_force": {"label": "Civilian labor force", "dimension": "workforce_community", "unit": "persons", "direction": "high_better", "transform": "ln", "ideal_T": 150000, "unacceptable_L": 2000, "anchor_basis": "Log transformation reduces skew and county-boundary effects"},
    "social_vulnerability_percentile": {"label": "CDC/ATSDR Social Vulnerability Index percentile", "dimension": "workforce_community", "unit": "fraction", "direction": "low_better", "transform": null, "ideal_T": 0.05, "unacceptable_L": 0.95, "anchor_basis": "Wide fixed anchors preserve differentiation; not a judgment of community value"},
    "historical_cdd65": {"label": "Cooling degree days (base 65 F)", "dimension": "cooling_climate", "unit": "degF-day/year", "direction": "low_better", "transform": null, "ideal_T": 700, "unacceptable_L": 2200, "anchor_basis": "Virginia-Georgia cooling-demand distribution"},
    "historical_days_tmax_gt90f": {"label": "Historical days per year above 90 F", "dimension": "cooling_climate", "unit": "days/year", "direction": "low_better", "transform": null, "ideal_T": 5, "unacceptable_L": 75, "anchor_basis": "Virginia-Georgia extreme-heat distribution"},
    "distance_to_interstate_km": {"label": "Distance to nearest Interstate", "dimension": "transportation", "unit": "km", "direction": "low_better", "transform": null, "ideal_T": 5, "unacceptable_L": 50, "anchor_basis": "Near-distance saturation with an upper-tail boundary"},
    "distance_to_rail_km": {"label": "Distance to nearest rail line", "dimension": "transportation", "unit": "km", "direction": "low_better", "transform": null, "ideal_T": 1, "unacceptable_L": 20, "anchor_basis": "Near-distance saturation with an upper-tail boundary"},
    "state_industrial_price": {"label": "State industrial electricity price", "dimension": "energy_carbon", "unit": "USD/MWh", "direction": "low_better", "transform": null, "ideal_T": 65, "unacceptable_L": 120, "anchor_basis": "Fixed national-context anchors"},
    "state_ieee_saidi_without_med": {"label": "State SAIDI excluding major events", "dimension": "energy_carbon", "unit": "minutes/customer/year", "direction": "low_better", "transform": null, "ideal_T": 100, "unacceptable_L": 300, "anchor_basis": "Fixed national reliability context"},
    "state_grid_co2e_intensity": {"label": "State grid CO2e intensity", "dimension": "energy_carbon", "unit": "kgCO2e/MWh", "direction": "low_better", "transform": null, "ideal_T": 200, "unacceptable_L": 600, "anchor_basis": "Fixed eGRID-context anchors"}
  },
  "dimensions": {
    "climate_risk": {"aggregation": "weighted_mean", "weights": {"wildfire_bp_national_percentile": 0.5, "inland_flood_loss_rate_percentile": 0.5}},
    "water": {"aggregation": "weighted_mean", "weights": {"baseline_water_stress": 0.5, "water_stress_2050_bau": 0.5}},
    "land_ecology": {"aggregation": "weighted_mean", "weights": {"low_impervious_land_share": 0.3333333333333333, "gap12_protected_land_share": 0.3333333333333333, "wetland_land_share": 0.3333333333333334}},
    "fiber": {"aggregation": "weighted_mean", "weights": {"fiber_business_100_20_availability": 0.5, "fiber_business_1000_100_availability": 0.5}},
    "workforce_community": {"aggregation": "weighted_mean", "weights": {"labor_force": 0.5, "social_vulnerability_percentile": 0.5}},
    "cooling_climate": {"aggregation": "weighted_mean", "weights": {"historical_cdd65": 0.5, "historical_days_tmax_gt90f": 0.5}},
    "transportation": {"aggregation": "weighted_mean", "weights": {"distance_to_interstate_km": 0.5, "distance_to_rail_km": 0.5}},
    "energy_carbon": {"aggregation": "weighted_mean", "weights": {"state_industrial_price": 0.3333333333333333, "state_ieee_saidi_without_med": 0.3333333333333333, "state_grid_co2e_intensity": 0.3333333333333334}}
  },
  "flags": {
    "water_stress_change_2050": {"label": "Change in water stress, 2050 BAU minus baseline (Aqueduct index points)", "formula": "water_stress_2050_bau - baseline_water_stress", "bands": [[-99, -0.5, "improving"], [-0.5, 0.5, "stable"], [0.5, 99, "worsening"]]},
    "fiber_100_20_availability": {"label": "Business fiber availability at 100/20 Mbps", "formula": "fiber_business_100_20_availability", "bands": null},
    "social_vulnerability": {"label": "CDC/ATSDR Social Vulnerability Index percentile", "formula": "social_vulnerability_percentile", "bands": [[0, 0.25, "low"], [0.25, 0.5, "low-moderate"], [0.5, 0.75, "moderate-high"], [0.75, 1.01, "high"]]},
    "extreme_heat_days": {"label": "Days per year above 90 F", "formula": "historical_days_tmax_gt90f", "bands": [[0, 15, "normal"], [15, 45, "elevated"], [45, 75, "high"], [75, 366, "extreme"]]}
  },
  "utility_floor": 0.0
}
